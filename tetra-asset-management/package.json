{
  "name": "tetra-asset-management-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "src/frontend",
    "src/backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=src/frontend",
    "dev:backend": "npm run dev --workspace=src/backend",
    "build:frontend": "npm run build --workspace=src/frontend",
    "build:backend": "npm run build --workspace=src/backend",
    "prisma:generate": "cd src/backend && npx prisma generate",
    "prisma:migrate": "cd src/backend && npx prisma migrate dev",
    "prisma:studio": "cd src/backend && npx prisma studio"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
